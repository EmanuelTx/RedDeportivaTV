# Cabeceras de Cloudflare Pages (GitHub Pages ignora este archivo).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Versión de prueba: que los buscadores no indexen la dirección *.pages.dev
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

# Los datos de prueba y el código de las funciones no son páginas para mostrar
/datos-prueba/*
  X-Robots-Tag: noindex, nofollow
